# 服务监听端口
PORT=3000
HOST=0.0.0.0

# 管理员密码（必须修改）
ADMIN_PASSWORD=please-change-me

# 会话签名密钥（生产必须设置，任意长随机串；重启后不变才能保留登录状态）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite 数据文件路径（默认为项目根目录 data.sqlite）
# DB_PATH=/data/menu-feedback.sqlite

# Anthropic API（可选）— 配置后启用 AI 起草回复
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 空库首次启动是否自动生成示例菜单（1 生成，0 不生成）
SEED_ON_EMPTY=1
